<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TasteBiteRestaurant.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - TasteBite Restaurant</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap" rel="stylesheet" />

    <!-- Custom Restaurant CSS -->
    <link rel="stylesheet" href="wwwroot/css/site.css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- Sticky Navigation Bar -->
        <header class="sticky-top">
            <nav class="navbar navbar-expand-lg navbar-custom shadow-sm">
                <div class="container">
                    <a class="navbar-brand" href="Default.aspx">
                        <span class="brand-badge"><i class="bi bi-fire"></i></span>
                        <span>Taste<span class="text-danger">Bite</span></span>
                    </a>

                    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarMain">
                        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-1">
                            <li class="nav-item">
                                <a class="nav-link <%= Request.Url.AbsolutePath.EndsWith("Default.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>" href="Default.aspx">
                                    <i class="bi bi-house-door me-1"></i> Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= Request.Url.AbsolutePath.EndsWith("Menu.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>" href="Menu.aspx">
                                    <i class="bi bi-journal-richtext me-1"></i> Menu
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= Request.Url.AbsolutePath.EndsWith("About.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>" href="About.aspx">
                                    <i class="bi bi-people me-1"></i> About Us
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= Request.Url.AbsolutePath.EndsWith("Contact.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>" href="Contact.aspx">
                                    <i class="bi bi-envelope me-1"></i> Contact
                                </a>
                            </li>
                        <% if (Session["user"] == null && Session["email"] == null) { %>
                            <li class="nav-item">
                                <a class="nav-link <%= Request.Url.AbsolutePath.EndsWith("Register.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>" href="Register.aspx">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= Request.Url.AbsolutePath.EndsWith("Login.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>" href="Login.aspx">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                        <% } else { %>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-primary fs-5 me-1"></i>
                                    <span>Hi, <%= Server.HtmlEncode((Session["username"] ?? Session["user"] ?? "Guest").ToString()) %></span>
                                    <% if ("Admin".Equals(Session["role"] as string, StringComparison.OrdinalIgnoreCase)) { %>
                                        <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">Admin</span>
                                    <% } %>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-1" aria-labelledby="userDropdown">
                                    <li class="px-3 py-2 text-muted small border-bottom">
                                        <div class="fw-bold text-dark"><%= Server.HtmlEncode((Session["username"] ?? Session["user"] ?? "").ToString()) %></div>
                                        <div class="text-truncate" style="max-width: 180px;"><%= Server.HtmlEncode((Session["email"] ?? "").ToString()) %></div>
                                    </li>
                                    <% if ("Admin".Equals(Session["role"] as string, StringComparison.OrdinalIgnoreCase)) { %>
                                        <li><a class="dropdown-item py-2 fw-semibold text-danger" href="Admin.aspx"><i class="bi bi-shield-lock me-2"></i> Admin Control Panel</a></li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                    <% } %>
                                    <li><a class="dropdown-item py-2" href="Menu.aspx"><i class="bi bi-journal-text me-2 text-primary"></i> Browse Menu</a></li>
                                    <li><a class="dropdown-item py-2" href="Cart.aspx"><i class="bi bi-cart3 me-2 text-danger"></i> View Cart</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li><a class="dropdown-item py-2 text-danger fw-semibold" href="Logout.aspx"><i class="bi bi-box-arrow-right me-2"></i> Log Out</a></li>
                                </ul>
                            </li>
                        <% } %>
                        </ul>

                        <div class="d-flex align-items-center gap-2">
                            <% if ("Admin".Equals(Session["UserRole"] as string, StringComparison.OrdinalIgnoreCase)) { %>
                                <a href="Admin.aspx" class="btn btn-sm btn-dark text-warning rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" title="Open Admin Management Panel">
                                    <i class="bi bi-shield-lock-fill text-warning"></i>
                                    <span>Admin Panel</span>
                                </a>
                            <% } %>
                            <a href="Menu.aspx" class="btn btn-outline-primary-custom d-none d-sm-inline-flex align-items-center">
                                <i class="bi bi-search me-1"></i> Order Now
                            </a>
                            <a href="Cart.aspx" class="nav-cart-btn text-decoration-none" title="View Shopping Cart">
                                <i class="bi bi-cart3 fs-5 text-danger"></i>
                                <span>Cart</span>
                                <asp:Label ID="lblCartCount" runat="server" CssClass="badge bg-danger rounded-pill cart-badge-pulse"></asp:Label>
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Main Body Content Placeholder -->
        <main role="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Restaurant Footer -->
        <footer class="footer-custom">
            <div class="container">
                <div class="row g-4 mb-5">
                    <div class="col-lg-4 col-md-6">
                        <a class="navbar-brand text-white mb-3" href="Default.aspx">
                            <span class="brand-badge"><i class="bi bi-fire"></i></span>
                            <span class="text-white">Taste<span class="text-danger">Bite</span></span>
                        </a>
                        <p class="text-white pe-lg-4">
                            Handcrafting culinary memories with artisan recipes, locally farm-sourced ingredients, and sizzling flavors cooked to perfection daily.
                        </p>
                        <div class="d-flex gap-2 mt-3">
                            <a href="javascript:void(0)" class="footer-social-icon" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="javascript:void(0)" class="footer-social-icon" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="javascript:void(0)" class="footer-social-icon" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                            <a href="javascript:void(0)" class="footer-social-icon" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-6">
                        <h5>Quick Links</h5>
                        <ul class="list-unstyled">
                            <li class="mb-2"><a href="Default.aspx"><i class="bi bi-chevron-right small me-1"></i> Home</a></li>
                            <li class="mb-2"><a href="Menu.aspx"><i class="bi bi-chevron-right small me-1"></i> Full Menu</a></li>
                            <li class="mb-2"><a href="About.aspx"><i class="bi bi-chevron-right small me-1"></i> Our Story</a></li>
                            <li class="mb-2"><a href="Contact.aspx"><i class="bi bi-chevron-right small me-1"></i> Contact Us</a></li>
                            <li class="mb-2"><a href="Cart.aspx"><i class="bi bi-chevron-right small me-1"></i> My Cart</a></li>
                            <li class="mb-2"><a href="Register.aspx"><i class="bi bi-chevron-right small me-1"></i> Register</a></li>
                            <li class="mb-2"><a href="Login.aspx"><i class="bi bi-chevron-right small me-1"></i> Sign In</a></li>
                        </ul>
                    </div>

                    <div class="col-lg-3 col-md-6 col-6">
                        <h5>Categories</h5>
                        <ul class="list-unstyled">
                            <li class="mb-2"><a href="Menu.aspx?category=Gujarati+Food"><i class="bi bi-chevron-right small me-1"></i> Gujarati Food</a></li>
                            <li class="mb-2"><a href="Menu.aspx?category=Gujarati+Thali"><i class="bi bi-chevron-right small me-1"></i> Gujarati Thali</a></li>
                            <li class="mb-2"><a href="Menu.aspx?category=Kathiyawadi+Shaak"><i class="bi bi-chevron-right small me-1"></i> Kathiyawadi Shaak</a></li>
                            <li class="mb-2"><a href="Menu.aspx?category=Farsan+%26+Snacks"><i class="bi bi-chevron-right small me-1"></i> Farsan &amp; Snacks</a></li>
                            <li class="mb-2"><a href="Menu.aspx?category=Mithai+%26+Sweets"><i class="bi bi-chevron-right small me-1"></i> Mithai &amp; Sweets</a></li>
                        </ul>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <h5>Opening Hours</h5>
                        <ul class="list-unstyled text-white small">
                            <li class="d-flex justify-content-between py-1 border-bottom border-dark">
                                <span class="text-white">Monday – Thursday:</span>
                                <span class="text-white fw-bold">10:00 AM – 10:30 PM</span>
                            </li>
                            <li class="d-flex justify-content-between py-1 border-bottom border-dark">
                                <span class="text-white">Friday – Saturday:</span>
                                <span class="text-white fw-bold">10:00 AM – 11:30 PM</span>
                            </li>
                            <li class="d-flex justify-content-between py-1 border-bottom border-dark">
                                <span class="text-white">Sunday:</span>
                                <span class="text-white fw-bold">10:00 AM – 11:00 PM</span>
                            </li>
                        </ul>
                        <div class="mt-3 p-3 rounded-3 bg-dark border border-secondary">
                            <div class="d-flex align-items-center gap-2 text-warning mb-1">
                                <i class="bi bi-truck fs-5"></i>
                                <span class="fw-bold">Fast Doorstep Delivery</span>
                            </div>
                            <p class="small text-white mb-0">Free shipping on all orders over ₹300!</p>
                        </div>
                    </div>
                </div>

                <div class="pt-4 mt-4 border-top border-secondary text-center text-white small">
                    <div class="row align-items-center">
                        <div class="col-md-6 text-md-start mb-2 mb-md-0 text-white">
                            &copy; <%= DateTime.Now.Year %> TasteBite Restaurant. All Rights Reserved. Crafted with ASP.NET Web Forms &amp; C#.
                        </div>
                        <div class="col-md-6 text-md-end text-white">
                            <span class="text-white"><i class="bi bi-shield-check text-success me-1"></i> Demo Online Ordering Platform</span>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </form>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="wwwroot/js/site.js"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
